generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  name                 String
  passwordHash         String?
  googleId             String?           @unique
  avatarUrl            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  sessions             Session[]
  wallets              UserWallet[]
  researchSessions     ResearchSession[]
  paymentRecords       PaymentRecord[]
  challenges           WalletChallenge[]
}

model Session {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String            @unique
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model WalletChallenge {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              String
  nonce                String            @unique
  expiresAt            DateTime
  createdAt            DateTime          @default(now())

  @@index([userId, address])
}

model UserWallet {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              String
  network              String            @default("testnet")
  label                String?
  isPrimary            Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([userId, address, network])
  @@index([userId])
  @@index([address])
}

model UserSpendingPolicy {
  id                   String            @id @default(uuid())
  userId               String            @unique
  maxPerTransaction    Int
  dailyLimit           Int
  // Stored as JSON string since SQLite doesn't support arrays
  allowedAssets        String
  // Stored as JSON string since SQLite doesn't support arrays
  allowedNetworks      String
  requireApprovalAbove Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model PaymentRecord {
  id                   String            @id @default(uuid())
  transactionId        String?           // Optional until settlement
  amount               Int
  asset                String
  receiver             String
  network              String
  decision             String            // APPROVED | DENIED | REQUIRES_APPROVAL
  status               String            // PENDING | SUCCESS | FAILED
  agentAction          String
  createdAt            DateTime          @default(now())

  userId               String?
  user                 User?             @relation(fields: [userId], references: [id])
  payerAddress         String?

  researchSessionId    String?
  ResearchSession      ResearchSession?  @relation(fields: [researchSessionId], references: [id])

  @@index([userId])
  @@index([payerAddress])
  @@index([transactionId])
}

model AgentSession {
  id                   String            @id @default(uuid())
  userId               String
  conversationId       String            @unique
  status               String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model ApprovalRequest {
  id                   String            @id @default(uuid())
  paymentRecordId      String            @unique
  status               String            // PENDING | APPROVED | REJECTED | EXPIRED | CANCELLED
  resourceUrl          String
  amount               Int
  asset                String
  network              String
  payTo                String
  reason               String
  requestedAt          DateTime          @default(now())
  expiresAt            DateTime
  approvedAt           DateTime?
  rejectedAt           DateTime?
  resolvedBy           String?
  resolutionReason     String?
  originalRequirement  String?
}

// ----------------------------------------
// Phase 6: Autonomous Research Models
// ----------------------------------------

model ResearchSession {
  id              String   @id @default(uuid())
  userId          String
  user            User?    @relation(fields: [userId], references: [id])
  walletAddress   String?
  goal            String
  status          String   // See State Machine below
  
  researchBudget  Int      @default(0) // Integer base units (e.g. 200000 for $0.20)
  spent           Int      @default(0) // Tracked total spent
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  failureReason   String?
  report          String?
  
  citations       Citation[]
  payments        PaymentRecord[] // Related payments for expense tracking
  recommendations PaidResourceRecommendation[]
  gaps            ResearchGap[]

  @@index([userId])
}

model Citation {
  id                String   @id @default(uuid())
  researchSessionId String
  url               String
  title             String?
  snippet           String?
  
  sourceType        String   // "WEB_SEARCH", "X402_RESOURCE"
  provider          String   // e.g. "Tavily", "MockSearch", "x402-bazaar"
  retrievedAt       DateTime @default(now())
  relevanceScore    Float?
  contentHash       String?
  
  isPaid            Boolean  @default(false)
  cost              Int      @default(0)
  purchaseId        String?  // Links to PaymentRecord if paid
  
  ResearchSession   ResearchSession @relation(fields: [researchSessionId], references: [id])
}

model PaidResourceRecommendation {
  id                String   @id @default(uuid())
  researchSessionId String
  
  service           String
  serviceUrl        String
  price             Int
  asset             String
  network           String
  
  reason            String
  relevanceScore    Float?
  expectedValue     String
  alternative       String
  
  status            String   // e.g. PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())
  
  ResearchSession   ResearchSession @relation(fields: [researchSessionId], references: [id])
}

model ResearchGap {
  id                  String   @id @default(uuid())
  researchSessionId   String
  hasMaterialGap      Boolean
  missingInformation  String   // JSON string array
  importance          String   // LOW, MEDIUM, HIGH
  evidenceSummary     String
  recommendedAction   String   // CONTINUE_FREE, DISCOVER_PAID
  evidenceCitationIds String   // JSON string array
  createdAt           DateTime @default(now())

  ResearchSession     ResearchSession @relation(fields: [researchSessionId], references: [id])
}
