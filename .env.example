# ==============================================================================
# AgentFlow — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Note: Variables in this file are for the BACKEND only unless prefixed
# with VITE_ (which would expose them to the frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC / CONFIGURATION (Safe to know, but keep backend-only by default)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- x402 Payment Config ---
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz/
X402_PRICE=0.10
X402_PAY_TO_ADDRESS=

# --- Algorand Config ---
ALGORAND_NETWORK=testnet
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
X402_USDC_ASSET_ID=10458941

# ------------------------------------------------------------------------------
# SECRETS (NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------

# --- Database (future) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/agentflow

# --- Authentication (future) ---
# JWT_SECRET=your-jwt-secret-here
# SESSION_SECRET=your-session-secret-here

# --- AI Provider ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Search Provider ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Algorand Credentials ---
X402_CLIENT_MNEMONIC="your disposable payer wallet 25-word mnemonic"