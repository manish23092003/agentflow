# ==============================================================================
# AgentFlow — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- Development (Localhost) ---
# Uncomment these for local development
# FRONTEND_URL=http://localhost:5173
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# DEMO_PAID_RESOURCE_URL=http://localhost:3002/research/premium

# --- Production ---
# REQUIRED in production. Do not use localhost.
# FRONTEND_URL=https://app.agentflow.com
# GOOGLE_REDIRECT_URI=https://api.agentflow.com/api/v1/auth/google/callback
# DEMO_PAID_RESOURCE_URL=https://api.agentflow.com/research/premium

# ------------------------------------------------------------------------------
# 2. SECRETS (NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------

# --- Database ---
# REQUIRED in production. PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agentflow"

# --- AI Provider ---
# REQUIRED
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Search Provider ---
# REQUIRED
TAVILY_API_KEY=your_tavily_api_key_here

# --- Google OAuth (Sign-In) ---
# REQUIRED
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. PAYMENT & X402 CONFIGURATION
# ------------------------------------------------------------------------------

# --- x402 Facilitator ---
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz/
X402_PRICE=0.10
X402_PAY_TO_ADDRESS=

# --- Algorand Config ---
ALGORAND_NETWORK=testnet
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
X402_USDC_ASSET_ID=10458941

# --- Algorand Credentials ---
X402_CLIENT_MNEMONIC="your disposable payer wallet 25-word mnemonic"