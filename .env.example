# ==============================================================================
# AgentFlow — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Note: Variables in this file are for the BACKEND only unless prefixed
# with VITE_ (which would expose them to the frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC / CONFIGURATION (Safe to know, but keep backend-only by default)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# --- x402 Payment Config (future) ---
# X402_FACILITATOR_URL=https://...
# X402_NETWORK=testnet

# --- Algorand Config (future) ---
# ALGORAND_NETWORK=testnet
# ALGORAND_NODE_URL=https://...

# ------------------------------------------------------------------------------
# SECRETS (NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------

# --- Database (future) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/agentflow

# --- Authentication (future) ---
# JWT_SECRET=your-jwt-secret-here
# SESSION_SECRET=your-session-secret-here

# --- AI Provider (future) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=openai
# AI_MODEL=gpt-4

# --- Algorand Credentials (future) ---
# ALGORAND_NODE_TOKEN=
# ALGORAND_WALLET_MNEMONIC=
